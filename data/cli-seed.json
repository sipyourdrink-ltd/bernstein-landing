  "commands": [
    {
      "name": "run",
      "summary": "execute a plan file (stages + steps)",
      "usage": "bernstein run [OPTIONS] [PLAN_FILE]",
      "description": "Run a plan file or, with --goal, an inline goal. Spawns agents in parallel git worktrees, gates merges via lint/type/test, and writes an HMAC-chained audit log under .sdd/.",
      "flags": [
        { "spec": "--goal, -g", "flags": ["--goal", "-g"], "primary": "--goal", "type": "TEXT", "help": "Inline goal (no seed file needed).", "default": null },
        { "spec": "--budget", "flags": ["--budget"], "primary": "--budget", "type": "FLOAT", "help": "Cost cap in USD; stop spawning agents when reached (0=unlimited).", "default": "0.0" },
        { "spec": "--cli", "flags": ["--cli"], "primary": "--cli", "type": "[claude|codex|gemini|qwen|auto]", "help": "Force a specific agent (overrides auto-detection).", "default": null },
        { "spec": "--model", "flags": ["--model"], "primary": "--model", "type": "MODEL", "help": "Force a specific model (e.g. opus, sonnet, o3).", "default": null },
        { "spec": "--from-plan", "flags": ["--from-plan"], "primary": "--from-plan", "type": "PATH", "help": "Execute a saved plan file (skips interactive planning).", "default": null },
        { "spec": "--dry-run", "flags": ["--dry-run"], "primary": "--dry-run", "type": "FLAG", "help": "Preview task plan without spawning agents.", "default": null },
        { "spec": "--plan-only", "flags": ["--plan-only"], "primary": "--plan-only", "type": "FLAG", "help": "Show execution plan without running agents.", "default": null },
        { "spec": "--auto-approve", "flags": ["--auto-approve"], "primary": "--auto-approve", "type": "FLAG", "help": "Skip confirmation prompt before execution.", "default": null },
        { "spec": "--approval", "flags": ["--approval"], "primary": "--approval", "type": "[auto|review|pr]", "help": "Approval gate.", "default": "auto" },
        { "spec": "--merge", "flags": ["--merge"], "primary": "--merge", "type": "[pr|direct]", "help": "Merge strategy.", "default": "pr" },
        { "spec": "--auto-pr", "flags": ["--auto-pr"], "primary": "--auto-pr", "type": "FLAG", "help": "Automatically create a GitHub PR when all tasks complete.", "default": null },
        { "spec": "--task, -t", "flags": ["--task", "-t"], "primary": "--task", "type": "PATTERN", "help": "Run only backlog tasks matching PATTERN.", "default": null },
        { "spec": "--sandbox", "flags": ["--sandbox"], "primary": "--sandbox", "type": "[docker|podman|worktree|e2b|modal|daytona|blaxel|runloop|vercel]", "help": "Sandbox backend.", "default": null },
        { "spec": "--allow-paid", "flags": ["--allow-paid"], "primary": "--allow-paid", "type": "FLAG", "help": "Allow paid cloud sandbox backends.", "default": null },
        { "spec": "--workflow", "flags": ["--workflow"], "primary": "--workflow", "type": "[governed]", "help": "Activate governed workflow mode.", "default": null },
        { "spec": "--fresh", "flags": ["--fresh"], "primary": "--fresh", "type": "FLAG", "help": "Ignore saved session; start clean.", "default": null },
        { "spec": "--resume", "flags": ["--resume"], "primary": "--resume", "type": "FLAG", "help": "Resume a checkpointed session.", "default": null },
        { "spec": "--audit", "flags": ["--audit"], "primary": "--audit", "type": "FLAG", "help": "Emit a verifiable audit-log bundle for this run.", "default": null }
      ],
      "subcommands": []
    },
    {
      "name": "doctor",
      "summary": "pre-flight: adapters, API keys, ports",
      "usage": "bernstein doctor [OPTIONS]",
      "description": "Diagnose a Bernstein workspace before running a goal. Checks installed CLI adapters, API key environment variables, port availability, MCP config sanity, and stale runtime state.",
      "flags": [
        { "spec": "--fix", "flags": ["--fix"], "primary": "--fix", "type": "FLAG", "help": "Apply safe fixes automatically.", "default": null },
        { "spec": "--strict", "flags": ["--strict"], "primary": "--strict", "type": "FLAG", "help": "Exit non-zero if any check is anything but pass.", "default": null },
        { "spec": "--json", "flags": ["--json"], "primary": "--json", "type": "FLAG", "help": "Emit results as JSON for CI consumption.", "default": null },
        { "spec": "--verbose, -v", "flags": ["--verbose", "-v"], "primary": "--verbose", "type": "FLAG", "help": "Show per-check details.", "default": null }
      ],
      "subcommands": []
    },
    {
      "name": "init",
      "summary": "initialize project (.sdd/ + bernstein.yaml)",
      "usage": "bernstein init [OPTIONS]",
      "description": "Set up a fresh Bernstein workspace in the current directory. Creates .sdd/ subtree, a starter bernstein.yaml, and registers .gitignore entries.",
      "flags": [
        { "spec": "--force", "flags": ["--force"], "primary": "--force", "type": "FLAG", "help": "Overwrite an existing bernstein.yaml.", "default": null },
        { "spec": "--template", "flags": ["--template"], "primary": "--template", "type": "TEXT", "help": "Init from a named template.", "default": null }
      ],
      "subcommands": []
    },
    {
      "name": "status",
      "summary": "task summary and agent health",
      "usage": "bernstein status [OPTIONS]",
      "description": "Print the current orchestration status: task counts by state, running agents, recent transitions, and cost-to-date.",
      "flags": [
        { "spec": "--json", "flags": ["--json"], "primary": "--json", "type": "FLAG", "help": "Emit JSON for scripting / CI.", "default": null },
        { "spec": "--watch", "flags": ["--watch"], "primary": "--watch", "type": "FLAG", "help": "Refresh every 2s until interrupted.", "default": null }
      ],
      "subcommands": []
    },
    {
      "name": "stop",
      "summary": "graceful stop (agents save work first)",
      "usage": "bernstein stop [OPTIONS]",
      "description": "Stop the current run. Default is graceful — running agents finish their current step and write their results before exiting. Use --force to kill immediately.",
      "flags": [
        { "spec": "--force", "flags": ["--force"], "primary": "--force", "type": "FLAG", "help": "Hard stop — kill agents immediately.", "default": null }
      ],
      "subcommands": []
    }
  ]
}
