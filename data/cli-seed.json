{
  "version": 1,
  "comment": "Seed catalog for the CLI glossary generated catalogue pages. Used when `bernstein` is not on PATH at build time. Hand-picked subset of the commands people reach for first, derived from `bernstein --help-all` output captured 2026-05-05. Re-extract to `data/cli.json` when bernstein is installed; the live catalog wins.",
  "root": {
    "usage": "bernstein [OPTIONS] COMMAND [ARGS]...",
    "description": "Declarative agent orchestration for engineering teams. Deterministic Python scheduler for CLI coding agents — 48 adapters, parallel git worktrees, HMAC-SHA256 audit chain (RFC 2104).",
    "flags": [
      { "spec": "--goal, -g", "flags": ["--goal", "-g"], "primary": "--goal", "type": "TEXT", "help": "Inline goal (no seed file needed).", "default": null },
      { "spec": "--budget", "flags": ["--budget"], "primary": "--budget", "type": "FLOAT", "help": "Cost cap in USD; stop spawning agents when reached (0=unlimited).", "default": "0.0" },
      { "spec": "--dry-run", "flags": ["--dry-run"], "primary": "--dry-run", "type": "FLAG", "help": "Preview task plan without spawning agents.", "default": null },
      { "spec": "--plan-only", "flags": ["--plan-only"], "primary": "--plan-only", "type": "FLAG", "help": "Show execution plan without running agents.", "default": null },
      { "spec": "--from-plan", "flags": ["--from-plan"], "primary": "--from-plan", "type": "PATH", "help": "Execute a saved plan file (skips interactive planning).", "default": null },
      { "spec": "--auto-approve", "flags": ["--auto-approve"], "primary": "--auto-approve", "type": "FLAG", "help": "Skip confirmation prompt before execution.", "default": null },
      { "spec": "--approval", "flags": ["--approval"], "primary": "--approval", "type": "[auto|review|pr]", "help": "Approval gate: auto=merge immediately, review=pause for human review, pr=open GitHub PR.", "default": "auto" },
      { "spec": "--merge", "flags": ["--merge"], "primary": "--merge", "type": "[pr|direct]", "help": "Merge strategy: pr=create GitHub PR (default), direct=push directly to main branch.", "default": "pr" },
      { "spec": "--cli", "flags": ["--cli"], "primary": "--cli", "type": "[claude|codex|gemini|qwen|auto]", "help": "Force a specific agent (overrides auto-detection).", "default": null },
      { "spec": "--model", "flags": ["--model"], "primary": "--model", "type": "MODEL", "help": "Force a specific model (e.g. opus, sonnet, o3).", "default": null },
      { "spec": "--workflow", "flags": ["--workflow"], "primary": "--workflow", "type": "[governed]", "help": "Activate governed workflow mode (deterministic phase-based execution).", "default": null },
      { "spec": "--verbose, -v", "flags": ["--verbose", "-v"], "primary": "--verbose", "type": "FLAG", "help": "Show debug-level output.", "default": null },
      { "spec": "--quiet, -q", "flags": ["--quiet", "-q"], "primary": "--quiet", "type": "FLAG", "help": "Suppress all non-error output.", "default": null },
      { "spec": "--task, -t", "flags": ["--task", "-t"], "primary": "--task", "type": "PATTERN", "help": "Run only backlog tasks matching PATTERN (e.g. 'gh-62' or 'mutant-fish').", "default": null },
      { "spec": "--auto-pr", "flags": ["--auto-pr"], "primary": "--auto-pr", "type": "FLAG", "help": "Automatically create a GitHub PR when all tasks complete.", "default": null },
      { "spec": "--activity-log", "flags": ["--activity-log"], "primary": "--activity-log", "type": "PATH", "help": "Write activity to log file. Default: .sdd/logs/activity.log", "default": ".sdd/logs/activity.log" },
      { "spec": "--sandbox", "flags": ["--sandbox"], "primary": "--sandbox", "type": "[docker|podman|worktree|e2b|modal|daytona|blaxel|runloop|vercel]", "help": "Sandbox backend (overrides selector). Free: worktree, docker, podman. Paid (require --allow-paid): e2b, modal, daytona, blaxel, runloop, vercel.", "default": null },
      { "spec": "--allow-paid", "flags": ["--allow-paid"], "primary": "--allow-paid", "type": "FLAG", "help": "Allow the sandbox selector to consider paid cloud backends.", "default": null },
      { "spec": "--fresh", "flags": ["--fresh"], "primary": "--fresh", "type": "FLAG", "help": "Ignore saved session; start from scratch.", "default": null },
      { "spec": "--version", "flags": ["--version"], "primary": "--version", "type": "FLAG", "help": "Show the version and exit.", "default": null }
    ],
    "subcommands": [
      { "name": "run", "help": "execute a plan file (stages + steps)" },
      { "name": "init", "help": "initialize project (.sdd/ + bernstein.yaml)" },
      { "name": "stop", "help": "graceful stop (agents save work first)" },
      { "name": "status", "help": "task summary and agent health" },
