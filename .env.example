# bernstein.run — environment variables.
# Copy to .env and fill in the values you need. .env is gitignored.
#
# Every variable here is optional. A checkout with an empty .env builds
# and serves the whole site; the features that need a credential
# fail closed and hide their own entry point rather than erroring.

# ---------------------------------------------------------------------
# Public origin
# ---------------------------------------------------------------------

# Origin used when the site has to write an absolute URL into a
# response (canonical links, signed links, sitemap entries).
# Defaults to https://bernstein.run.
# BERNSTEIN_PUBLIC_ORIGIN=https://bernstein.run

# ---------------------------------------------------------------------
# GitHub
# ---------------------------------------------------------------------

# Read-only token for the star / PR / contributor counts rendered by
# /api/stats and lib/pkg-stats.ts. Unauthenticated GitHub allows 60
# requests per hour per IP, which several server-rendered pages exhaust
# between deploys — the visible symptom is a star count frozen at a
# stale value. A classic token with only the `public_repo` read scope
# raises the ceiling to 5000/h. Generate one at
# https://github.com/settings/tokens.
# GITHUB_TOKEN=

# ---------------------------------------------------------------------
# Analytics
# ---------------------------------------------------------------------

# Website id for the self-hosted, cookieless analytics instance named on
# /privacy. NEXT_PUBLIC_ means Next.js inlines it at BUILD time. When it
# is unset the layout emits no script tag at all, so a misconfigured
# preview build cannot report into the production site.
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# Origin the analytics script and any server-side event post are sent
# to. Defaults to the instance named on /privacy.
# UMAMI_COLLECT_URL=

# ---------------------------------------------------------------------
# Host-supplied services
# ---------------------------------------------------------------------
#
# The hosted instance runs a retrieval and summarisation service, a
# mailing list and a set of deploy units that are supplied by the host
# and are not part of this repository. Their code is absent here by
# design; the routes that would call them are absent with it, and the
# UI that would link to them renders without the link.
#
# If you are standing up your own instance, these are the seams:
#
#   AI_GATEWAY_URL        origin of a retrieval/summarisation service
#                         answering the /ask and blog-summary contracts
#   OPENROUTER_API_KEY    direct model access, if you would rather call
#                         a provider than run a service
#   RESEND_API_KEY_*      transactional mail for the digest signup
#   SIGNAL_LOG_SECRET     shared secret for the completion-log relay
#
# Leave every one of them unset to run the site without those features.
