{
  "ci": {
    "collect": {
      "startServerCommand": "npm run start",
      "url": ["http://localhost:3000/"],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "warn",
          { "minScore": 0.85 }
        ],
        "largest-contentful-paint": [
          "warn",
          { "maxNumericValue": 2200 }
        ]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
